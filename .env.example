# ── Frontend (Next.js) ──────────────────────────────────────────────
# URL base da API (backend NestJS). O frontend usa para autenticação e dados.
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Segredo compartilhado com o backend (o MESMO valor em backend/.env).
# Mínimo de 32 caracteres. Gere um com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="troque-por-uma-chave-secreta-de-32-caracteres-min"