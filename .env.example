# Banco de dados PostgreSQL
# Exemplo local: postgresql://usuario:senha@localhost:5432/gerenciador_leads?schema=public
# Gratuito: crie um projeto em https://neon.tech ou https://supabase.com e cole a connection string
DATABASE_URL="postgresql://usuario:senha@localhost:5432/gerenciador_leads?schema=public"

# Segredo compartilhado com o backend (JWT_SECRET). Deve ter no mínimo 32 caracteres.
# Gere um seguro com: openssl rand -hex 32
JWT_SECRET="troque-por-uma-chave-secreta-de-32-caracteres-min"

# Backend de prospecção (NestJS) — usada pela página "Envio manual"
# URL base da API NestJS (Fase 1: localhost:3001) e o id do tenant (X-Org-ID)
PROSPECTING_API_URL="http://localhost:3001"
PROSPECTING_ORG_ID="org-demo"