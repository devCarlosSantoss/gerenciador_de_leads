// Leads Pro - Modelo de dados para aplicação pessoal (single-user)
// Sem multi-tenancy, sem organizations, sem roles complexos.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ────────────────────────────── Enums ──────────────────────────────

enum LeadStatus {
  NEW
  ANALYZING
  ANALYZED
  MESSAGE_GENERATED
  MESSAGE_PENDING_APPROVAL
  MESSAGE_APPROVED
  CHAT_LINK_OPENED
  MESSAGE_COPIED
  SEND_CONFIRMATION_PENDING
  CONTACTED_CONFIRMED
  REPLIED
  QUALIFIED
  MEETING_BOOKED
  PROPOSAL_SENT
  CONVERTED
  NOT_INTERESTED
  LOST
  OPT_OUT
  BLOCKED
  ERROR
  ARCHIVED
}

enum ContactChannel {
  WHATSAPP
  INSTAGRAM
  EMAIL
  PHONE
  LINKEDIN
}

enum MessageStatus {
  DRAFT
  APPROVED
  SENT
  FAILED
}

enum MessageDirection {
  OUTBOUND
  INBOUND
}

enum TaskType {
  REVIEW_APPROVAL
  FOLLOW_UP
  RESPONSE_TRIAGE
  SITE_RECHECK
  DATA_FIX
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
  OVERDUE
}

enum WebsiteStatus {
  NO_WEBSITE
  ACTIVE
  UNREACHABLE
  PARKED
  UNKNOWN
}

enum ScoreTier {
  HIGH
  MEDIUM
  NURTURE
  LOW
}

enum AnalysisStatus {
  QUEUED
  RUNNING
  COMPLETED
  PARTIAL
  NEEDS_HUMAN_REVIEW
  FAILED
}

enum SocialPlatform {
  INSTAGRAM
  LINKEDIN
  FACEBOOK
  OTHER
}

enum ConsentStatus {
  NOT_APPLICABLE
  GRANTED
  DENIED
  WITHDRAWN
  IMPLIED
}

enum LegalBasis {
  LEGITIMATE_INTEREST
  CONTRACT
  CONSENT
  PUBLIC_INFO
  NO_BASIS
}

enum SourceClass {
  OFFICIAL_API
  LICENSED
  PUBLIC
  SCRAPED
  FIRST_PARTY
  USER_PROVIDED
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  PARTIAL
  FAILED
}

enum DedupResult {
  NEW
  DUPLICATE_EXACT
  DUPLICATE_SUGGESTED
  CONFLICT
}

enum FindingCategory {
  FACT
  INFERENCE
  UNKNOWN
  RISK
}

enum FindingValueType {
  STRING
  NUMBER
  BOOLEAN
  URL
  METRIC
  JSON
}

enum EvidenceSourceType {
  WEBSITE_HTTP
  HTML_ANALYSIS
  LIGHTHOUSE
  PAGESPEED
  DNS
  SOCIAL_PUBLIC
  USER_INPUT
  AI_INFERENCE
}

enum EvidenceType {
  HTML_ELEMENT
  TEXT
  METRIC
  SCREENSHOT
  EXTERNAL_DOC
  USER_INPUT
}

// ────────────────────────────── Models ──────────────────────────────

model AdminUser {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String
  passwordHash      String
  mustChangePassword Boolean   @default(false)
  passwordChangedAt DateTime?
  failedLoginAttempts Int       @default(0)
  lockedUntil       DateTime?
  active            Boolean   @default(true)
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  refreshTokens     RefreshToken[]
  passwordResetTokens PasswordResetToken[]
}

model RefreshToken {
  id            String    @id @default(cuid())
  userId        String
  tokenHash     String    @unique
  familyId      String
  expiresAt     DateTime
  revokedAt     DateTime?
  replacedBy    String?
  userAgent     String?
  ipAddress     String?
  createdAt     DateTime  @default(now())

  user          AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model PasswordResetToken {
  id            String    @id @default(cuid())
  userId        String
  tokenHash     String    @unique
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())

  user          AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Lead {
  id                   String         @id @default(cuid())
  externalId           String?        @unique
  name                 String
  nameNormalized       String?
  category             String?
  address              String?
  city                 String?
  state                String?        @db.Char(2)
  postalCode           String?
  latitude             Float?
  longitude            Float?
  phoneE164            String?        @unique
  canonicalDomain      String?        @unique
  rating               Float?
  reviewsCount         Int?
  websiteStatus        WebsiteStatus  @default(UNKNOWN)
  status               LeadStatus     @default(NEW)
  contactStatus        LeadStatus?
  contactedConfirmedAt DateTime?
  dataOrigin           String
  sourceUrl            String?
  collectedAt          DateTime
  legalBasis           LegalBasis     @default(NO_BASIS)
  purpose              String?
  notes                String?
  deletedAt            DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  contacts             LeadContact[]
  websites             LeadWebsite[]
  socialProfiles       SocialProfile[]
  scores               LeadScore[]
  analysisRuns         AnalysisRun[]
  messages             MessageDraft[]
  suppressions         SuppressionList[]
  tasks                Task[]
  contactStatusHistory ContactStatusHistory[]
  contactAttempts      ContactAttempt[]
  activityEvents       ActivityEvent[]

  @@index([status])
  @@index([city, state])
  @@index([nameNormalized])
  @@index([canonicalDomain])
  @@index([phoneE164])
  @@index([externalId])
}

model LeadContact {
  id              String         @id @default(cuid())
  leadId          String
  type            ContactChannel
  value           String
  valueNormalized String
  isPrimary       Boolean        @default(false)
  isValid         Boolean        @default(false)
  isVerified      Boolean        @default(false)
  verifiedAt      DateTime?
  sourceKey       String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  lead            Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([type, valueNormalized])
  @@index([leadId])
  @@index([isValid, isVerified])
}

model LeadImport {
  id               String       @id @default(cuid())
  sourceKey        String
  externalId       String?
  leadName         String
  rawPayload       Json
  collectedAt      DateTime
  ingestedAt       DateTime     @default(now())
  purpose          String?
  dedupResult      DedupResult?
  dedupReason      String?
  matchedLeadId    String?
  status           ImportStatus @default(PENDING)
  error            String?

  @@index([sourceKey, collectedAt])
  @@index([matchedLeadId])
}

model LeadWebsite {
  id             String        @id @default(cuid())
  leadId         String
  url            String
  domain         String        @unique
  status         WebsiteStatus @default(UNKNOWN)
  lastFetchedAt  DateTime?
  httpStatus     Int?
  isHttps        Boolean?
  tlsValid       Boolean?
  hasRobots      Boolean?
  redirectTo     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  lead           Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  audits         WebsiteAudit[]

  @@index([leadId])
}

model WebsiteAudit {
  id             String   @id @default(cuid())
  websiteId      String
  tool           String
  auditedAt      DateTime @default(now())
  metrics        Json
  checks         Json
  errors         String[] @default([])
  raw            Json?

  website        LeadWebsite @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId])
  @@index([auditedAt])
}

model SocialProfile {
  id             String         @id @default(cuid())
  leadId         String
  platform       SocialPlatform
  handle         String
  url            String?
  discoveredAt   DateTime       @default(now())
  isOfficial     Boolean?
  verifiedBy     String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  lead           Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([platform, handle])
  @@index([leadId])
}

model LeadScore {
  id             String    @id @default(cuid())
  leadId         String
  score          Int
  tier           ScoreTier
  components     Json
  calculatedAt   DateTime  @default(now())
  calculatedBy   String
  rationale      String?

  lead           Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([score])
}

model AnalysisRun {
  id                  String         @id @default(cuid())
  leadId              String
  provider            String         @default("unknown")
  model               String
  promptVersion       String
  inputSnapshot       Json
  output              Json
  requiresHumanReview Boolean        @default(false)
  status              AnalysisStatus @default(COMPLETED)
  error               String?
  startedAt           DateTime?
  finishedAt          DateTime?
  durationMs          Int?
  createdAt           DateTime       @default(now())

  lead                Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  findings            AnalysisFinding[]
  recommendations     AnalysisRecommendation[]
  conflicts           AnalysisConflict[]

  @@index([leadId, createdAt])
  @@index([status])
  @@map("analysis_runs")
}

model AnalysisFinding {
  id                  String             @id @default(cuid())
  leadId              String
  analysisRunId       String
  category            FindingCategory
  claim               String
  value               Json?
  valueType           FindingValueType
  sourceType          EvidenceSourceType
  confidence          Float?
  requiresHumanReview Boolean            @default(false)
  messageEligible     Boolean            @default(false)
  createdAt           DateTime           @default(now())

  analysisRun         AnalysisRun        @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
  evidence            AnalysisEvidence[]
  conflictFrom        AnalysisConflict[] @relation("ConflictFrom")
  conflictTo          AnalysisConflict[] @relation("ConflictTo")

  @@index([leadId, category])
  @@index([analysisRunId])
  @@map("analysis_findings")
}

model AnalysisEvidence {
  id                  String             @id @default(cuid())
  findingId           String
  url                 String?
  evidenceType        EvidenceType
  sourceType          EvidenceSourceType
  selector            String?
  extractedText       String?
  metricName          String?
  metricValue         Float?
  screenshotReference String?
  collectedAt         DateTime           @default(now())
  hash                String

  finding             AnalysisFinding    @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@index([findingId])
  @@map("analysis_evidence")
}

model AnalysisRecommendation {
  id                  String   @id @default(cuid())
  leadId              String
  analysisRunId       String
  kind                String
  title               String
  description         String?
  confidence          Float?
  priority            String?
  requiresHumanReview Boolean  @default(false)
  createdAt           DateTime @default(now())

  analysisRun         AnalysisRun @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)

  @@index([leadId, kind])
  @@map("analysis_recommendations")
}

model AnalysisConflict {
  id             String   @id @default(cuid())
  analysisRunId  String
  fromFindingId  String
  toFindingId    String
  nature         String
  resolution     String?
  createdAt      DateTime @default(now())

  fromFinding    AnalysisFinding @relation("ConflictFrom", fields: [fromFindingId], references: [id], onDelete: Cascade)
  toFinding      AnalysisFinding @relation("ConflictTo", fields: [toFindingId], references: [id], onDelete: Cascade)
  analysisRun    AnalysisRun     @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)

  @@index([analysisRunId])
  @@map("analysis_conflicts")
}

model MessageDraft {
  id                String           @id @default(cuid())
  leadId            String
  channel           ContactChannel   @default(WHATSAPP)
  status            MessageStatus    @default(DRAFT)
  direction         MessageDirection @default(OUTBOUND)
  content           String
  contentHash       String
  externalMessageId String?          @unique
  externalStatus    String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  errorCode         String?
  errorDetail       String?
  providerConfig    Json?
  approvedBy        String?
  approvedAt        DateTime?
  sentBy            String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  lead              Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contactAttempts   ContactAttempt[]
  activityEvents    ActivityEvent[]

  @@index([leadId])
  @@index([status])
}

model SuppressionList {
  id             String         @id @default(cuid())
  leadId         String?
  contact        String?
  channel        ContactChannel
  reason         String
  sourceKey      String
  createdAt      DateTime       @default(now())
  expiresAt      DateTime?
  note           String?

  lead           Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([contact])
  @@index([leadId])
}

model Task {
  id             String     @id @default(cuid())
  leadId         String?
  type           TaskType
  status         TaskStatus @default(OPEN)
  dueAt          DateTime?
  completedAt    DateTime?
  payload        Json?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  lead           Lead?      @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([status, dueAt])
  @@index([leadId])
}

model ContactStatusHistory {
  id             String          @id @default(cuid())
  leadId         String
  fromStatus     LeadStatus?
  toStatus       LeadStatus
  transition     String
  actorId        String?
  actorType      String          @default("user")
  messageId      String?
  channel        ContactChannel?
  metadata       Json?
  createdAt      DateTime        @default(now())

  lead           Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@index([transition, createdAt])
  @@map("lead_status_history")
}

model ContactAttempt {
  id                String               @id @default(cuid())
  leadId            String
  messageId         String?
  channel           ContactChannel
  action            String
  confirmedBy       String?
  confirmedAt       DateTime?
  metadata          Json?
  createdAt         DateTime             @default(now())

  lead              Lead                 @relation(fields: [leadId], references: [id], onDelete: Cascade)
  message           MessageDraft?        @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([leadId, action, createdAt])
  @@index([channel, action, createdAt])
  @@map("contact_attempts")
}

model ActivityEvent {
  id             String          @id @default(cuid())
  leadId         String?
  messageId      String?
  actorId        String?
  actorType      String          @default("user")
  eventType      String
  entityType     String?
  entityId       String?
  channel        ContactChannel?
  payload        Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime        @default(now())

  lead           Lead?           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  message        MessageDraft?   @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
  @@index([eventType, createdAt])
  @@map("activity_events")
}

model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AiUsageEvent {
  id             String   @id @default(cuid())
  feature        String
  provider       String
  model          String
  durationMs     Int
  tokensIn       Int?
  tokensOut      Int?
  estimatedCost  Float?
  success        Boolean
  error          String?
  createdAt      DateTime @default(now())

  @@index([feature, createdAt])
  @@index([provider, model, createdAt])
}

model JobFailure {
  id             String   @id @default(cuid())
  queue          String
  jobId          String
  jobName        String
  error          String
  attemptsMade   Int
  maxAttempts    Int
  payload        Json
  createdAt      DateTime @default(now())
  resolvedAt     DateTime?
  resolvedBy     String?

  @@index([queue, createdAt])
  @@index([jobId])
}