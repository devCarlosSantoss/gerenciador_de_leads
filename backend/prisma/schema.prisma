// Plataforma de prospecção — Aurora Code Tech
// Modelo de dados Fase 1 (MVP seguro). Multi-organização, soft delete,
// campos LGPD, idempotência de webhooks/jobs.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ────────────────────────────── Enums ──────────────────────────────

enum Role {
  OWNER
  ADMIN
  OPERATOR
  ANALYST
  VIEWER
}

// MFA preparado como extensão futura (Fase 2): hoje apenas NONE é aceito.
enum MFAMethod {
  NONE
  TOTP
  EMAIL_OTP
}

enum LeadStatus {
  NOVO
  IMPORTADO
  EM_ANALISE
  AGUARDANDO_REVISAO
  APROVADO
  PRONTO_PARA_CONTATO
  ENVIADO
  ENTREGUE
  LIDO
  RESPONDEU
  INTERESSADO
  SEM_INTERESSE
  AGUARDANDO_RETORNO
  REUNIAO_MARCADA
  CONVERTIDO
  OPT_OUT
  BLOQUEADO
  ERRO
  ARQUIVADO
}

enum ContactStatus {
  NEW
  ANALYZING
  ANALYZED
  MESSAGE_GENERATED
  PENDING_APPROVAL
  APPROVED
  CHAT_LINK_OPENED
  MESSAGE_COPIED
  SEND_CONFIRMATION_PENDING
  CONTACTED_CONFIRMED
  REPLIED
  QUALIFIED
  MEETING_BOOKED
  PROPOSAL_SENT
  CONVERTED
  NOT_INTERESTED
  LOST
  OPT_OUT
  BLOCKED
  ARCHIVED
  ERROR
}

enum ContactAttemptAction {
  LINK_OPENED
  MESSAGE_COPIED
  SEND_CONFIRMED
  REPLY_REGISTERED
  OPT_OUT_REGISTERED
}

enum ContactChannel {
  WHATSAPP
  INSTAGRAM
  EMAIL
  PHONE
  LINKEDIN
}

enum MessageStatus {
  DRAFT
  APPROVED
  QUEUED
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
  PAUSED
  OPT_OUT
}

enum MessageDirection {
  OUTBOUND
  INBOUND
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  STOPPED
  FAILED
}

enum CampaignMode {
  ASSISTED
  AUTOMATED
}

enum ConsentStatus {
  NOT_APPLICABLE
  GRANTED
  DENIED
  WITHDRAWN
  IMPLIED
}

enum LegalBasis {
  LEGITIMATE_INTEREST
  CONTRACT
  CONSENT
  PUBLIC_INFO
  NO_BASIS
}

enum SourceClass {
  OFFICIAL_API
  LICENSED
  PUBLIC
  SCRAPED
  FIRST_PARTY
  USER_PROVIDED
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  PARTIAL
  FAILED
}

enum DedupResult {
  NEW
  DUPLICATE_EXACT
  DUPLICATE_SUGGESTED
  CONFLICT
}

enum TaskType {
  REVIEW_APPROVAL
  FOLLOW_UP
  RESPONSE_TRIAGE
  SITE_RECHECK
  DATA_FIX
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
  OVERDUE
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
  RETRYING
  DUPLICATE
}

enum WebsiteStatus {
  NO_WEBSITE
  ACTIVE
  UNREACHABLE
  PARKED
  UNKNOWN
}

enum ScoreTier {
  HIGH
  MEDIUM
  NURTURE
  LOW
}

enum AnalysisStatus {
  QUEUED
  RUNNING
  COMPLETED
  PARTIAL
  NEEDS_HUMAN_REVIEW
  FAILED
}

enum SocialPlatform {
  INSTAGRAM
  LINKEDIN
  FACEBOOK
  OTHER
}

enum ConversationStatus {
  OPEN
  PENDING
  RESOLVED
  TRANSFERRED
  BLOCKED
}

enum TemplateStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  PAUSED
}

// ────────────────────────────── Models ──────────────────────────────

model User {
  id                  String    @id @default(cuid())
  organizationId      String
  email               String
  name                String
  role                Role      @default(OPERATOR)
  oauthProvider       String?   @default("google")
  passwordHash        String?
  // MFA como extensão futura — campos presentes, mas sem fluxo implementado.
  mfaEnabled          Boolean   @default(false)
  mfaMethod           MFAMethod @default(NONE)
  mfaSecretEncrypted  String?
  mustChangePassword  Boolean   @default(false)
  passwordChangedAt   DateTime?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  active              Boolean   @default(true)
  lastLoginAt         DateTime?
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]

  @@unique([organizationId, email])
  @@index([organizationId])
}

model RefreshToken {
  id             String    @id @default(cuid())
  userId         String
  organizationId String
  // Armazenamos apenas o hash SHA-256 do token — nunca o token em texto puro.
  tokenHash      String    @unique
  familyId       String
  expiresAt      DateTime
  revokedAt      DateTime?
  replacedBy     String?
  userAgent      String?
  ipAddress      String?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([organizationId])
}

model PasswordResetToken {
  id             String    @id @default(cuid())
  userId         String
  organizationId String
  // Apenas o hash SHA-256 do token é persistido (uso único).
  tokenHash      String    @unique
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
}

model LeadSource {
  id              String      @id @default(cuid())
  organizationId  String
  key             String
  name            String
  class           SourceClass @default(PUBLIC)
  enabled         Boolean     @default(true)
  requiresConsent Boolean     @default(false)
  allowedFields   String[]    @default([])
  config          Json?
  deletedAt       DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([organizationId, key])
}

model Company {
  id                   String         @id @default(cuid())
  organizationId       String
  externalId           String?
  name                 String
  nameNormalized       String?
  category             String?
  address              String?
  city                 String?
  state                String?        @db.Char(2)
  postalCode           String?
  latitude             Float?
  longitude            Float?
  phoneE164            String?
  canonicalDomain      String?
  rating               Float?
  reviewsCount         Int?
  websiteStatus        WebsiteStatus  @default(UNKNOWN)
  status               LeadStatus     @default(NOVO)
  contactStatus        ContactStatus?
  contactedConfirmedAt DateTime?
  dataOrigin           String
  sourceUrl            String?
  collectedAt          DateTime
  legalBasis           LegalBasis     @default(NO_BASIS)
  purpose              String?
  notes                String?
  deletedAt            DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  contacts             Contact[]
  websites             Website[]
  socialProfiles       SocialProfile[]
  scores               LeadScore[]
  analysisRuns         AnalysisRun[]
  campaignLeads        CampaignLead[]
  messages             Message[]
  conversations        Conversation[]
  consents             ConsentRecord[]
  suppressions         SuppressionList[]
  tasks                Task[]
  contactStatusHistory ContactStatusHistory[]
  contactAttempts      ContactAttempt[]
  activityEvents       ActivityEvent[]

  @@unique([organizationId, externalId])
  @@unique([organizationId, phoneE164])
  @@unique([organizationId, canonicalDomain])
  @@index([organizationId, status])
  @@index([organizationId, city, state])
  @@index([organizationId, nameNormalized])
}

model Contact {
  id              String         @id @default(cuid())
  organizationId  String
  companyId       String
  type            ContactChannel
  value           String
  valueNormalized String
  isPrimary       Boolean        @default(false)
  isValid         Boolean        @default(false)
  isVerified      Boolean        @default(false)
  verifiedAt      DateTime?
  sourceKey       String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([organizationId, type, valueNormalized])
  @@index([companyId])
  @@index([organizationId, isValid, isVerified])
}

model LeadImport {
  id               String       @id @default(cuid())
  organizationId   String
  sourceKey        String
  externalId       String?
  companyName      String
  rawPayload       Json
  collectedAt      DateTime
  ingestedAt       DateTime     @default(now())
  purpose          String?
  dedupResult      DedupResult?
  dedupReason      String?
  matchedCompanyId String?
  status           ImportStatus @default(PENDING)
  error            String?

  @@index([organizationId, sourceKey, collectedAt])
  @@index([organizationId, matchedCompanyId])
}

model Website {
  id             String        @id @default(cuid())
  organizationId String
  companyId      String
  url            String
  domain         String
  status         WebsiteStatus @default(UNKNOWN)
  lastFetchedAt  DateTime?
  httpStatus     Int?
  isHttps        Boolean?
  tlsValid       Boolean?
  hasRobots      Boolean?
  redirectTo     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  company Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  audits  WebsiteAudit[]

  @@unique([organizationId, domain])
  @@index([companyId])
}

model WebsiteAudit {
  id             String   @id @default(cuid())
  organizationId String
  websiteId      String
  tool           String
  auditedAt      DateTime @default(now())
  metrics        Json
  checks         Json
  errors         String[] @default([])
  raw            Json?

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId])
  @@index([organizationId, auditedAt])
}

model SocialProfile {
  id             String         @id @default(cuid())
  organizationId String
  companyId      String
  platform       SocialPlatform
  handle         String
  url            String?
  discoveredAt   DateTime       @default(now())
  isOfficial     Boolean?
  verifiedBy     String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([organizationId, platform, handle])
  @@index([companyId])
}

model LeadScore {
  id             String    @id @default(cuid())
  organizationId String
  companyId      String
  score          Int
  tier           ScoreTier
  components     Json
  calculatedAt   DateTime  @default(now())
  calculatedBy   String
  rationale      String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([organizationId, score])
}

model AnalysisRun {
  id                  String         @id @default(cuid())
  organizationId      String
  companyId           String
  provider            String         @default("unknown")
  model               String
  promptVersion       String
  inputSnapshot       Json
  output              Json
  requiresHumanReview Boolean        @default(false)
  status              AnalysisStatus @default(COMPLETED)
  error               String?
  startedAt           DateTime?
  finishedAt          DateTime?
  durationMs          Int?
  createdAt           DateTime       @default(now())

  company         Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  findings        AnalysisFinding[]
  recommendations AnalysisRecommendation[]
  conflicts       AnalysisConflict[]

  @@index([companyId, createdAt])
  @@index([organizationId, status])
  @@map("analysis_runs")
}

enum FindingCategory {
  FACT
  INFERENCE
  UNKNOWN
  RISK
}

enum FindingValueType {
  STRING
  NUMBER
  BOOLEAN
  URL
  METRIC
  JSON
}

enum EvidenceSourceType {
  WEBSITE_HTTP
  HTML_ANALYSIS
  LIGHTHOUSE
  PAGESPEED
  DNS
  SOCIAL_PUBLIC
  USER_INPUT
  AI_INFERENCE
}

enum EvidenceType {
  HTML_ELEMENT
  TEXT
  METRIC
  SCREENSHOT
  EXTERNAL_DOC
  USER_INPUT
}

model AnalysisFinding {
  id                  String             @id @default(cuid())
  organizationId      String
  leadId              String
  analysisRunId       String
  category            FindingCategory
  claim               String
  value               Json?
  valueType           FindingValueType
  sourceType          EvidenceSourceType
  confidence          Float?
  requiresHumanReview Boolean            @default(false)
  messageEligible     Boolean            @default(false)
  createdAt           DateTime           @default(now())

  analysisRun  AnalysisRun        @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
  evidence     AnalysisEvidence[]
  conflictFrom AnalysisConflict[] @relation("ConflictFrom")
  conflictTo   AnalysisConflict[] @relation("ConflictTo")

  @@index([leadId, category])
  @@index([analysisRunId])
  @@map("analysis_findings")
}

model AnalysisEvidence {
  id                  String             @id @default(cuid())
  organizationId      String
  findingId           String
  url                 String?
  evidenceType        EvidenceType
  sourceType          EvidenceSourceType
  selector            String?
  extractedText       String?
  metricName          String?
  metricValue         Float?
  screenshotReference String?
  collectedAt         DateTime           @default(now())
  hash                String

  finding AnalysisFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@index([findingId])
  @@map("analysis_evidence")
}

model AnalysisRecommendation {
  id                  String   @id @default(cuid())
  organizationId      String
  leadId              String
  analysisRunId       String
  kind                String
  title               String
  description         String?
  confidence          Float?
  priority            String?
  requiresHumanReview Boolean  @default(false)
  createdAt           DateTime @default(now())

  analysisRun AnalysisRun @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)

  @@index([leadId, kind])
  @@map("analysis_recommendations")
}

model AnalysisConflict {
  id             String   @id @default(cuid())
  organizationId String
  analysisRunId  String
  fromFindingId  String
  toFindingId    String
  nature         String
  resolution     String?
  createdAt      DateTime @default(now())

  fromFinding AnalysisFinding @relation("ConflictFrom", fields: [fromFindingId], references: [id], onDelete: Cascade)
  toFinding   AnalysisFinding @relation("ConflictTo", fields: [toFindingId], references: [id], onDelete: Cascade)
  analysisRun AnalysisRun     @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)

  @@index([analysisRunId])
  @@map("analysis_conflicts")
}

model Campaign {
  id             String         @id @default(cuid())
  organizationId String
  name           String
  channel        ContactChannel @default(WHATSAPP)
  status         CampaignStatus @default(DRAFT)
  mode           CampaignMode   @default(ASSISTED)
  templateId     String?
  scheduleStart  DateTime?
  scheduleEnd    DateTime?
  allowedHours   Json
  dailyCap       Int            @default(30)
  dailySent      Int            @default(0)
  pausedReason   String?
  minScore       Int            @default(60)
  requireConsent Boolean        @default(true)
  createdById    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  leads CampaignLead[]

  @@index([organizationId, status])
}

model CampaignLead {
  id           String        @id @default(cuid())
  campaignId   String
  companyId    String
  status       MessageStatus @default(DRAFT)
  approvedById String?
  approvedAt   DateTime?
  scheduledFor DateTime?
  sentAt       DateTime?
  deliveredAt  DateTime?
  readAt       DateTime?
  repliedAt    DateTime?
  messageId    String?
  lastError    String?
  retryCount   Int           @default(0)
  optOutAt     DateTime?

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([campaignId, companyId])
  @@index([companyId])
  @@index([campaignId, status])
}

model MessageTemplate {
  id             String         @id @default(cuid())
  organizationId String
  name           String
  channel        ContactChannel @default(WHATSAPP)
  externalId     String?
  status         TemplateStatus @default(DRAFT)
  body           String
  variables      String[]       @default([])
  language       String         @default("pt_BR")
  category       String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  @@unique([organizationId, name])
}

model Message {
  id                String           @id @default(cuid())
  organizationId    String
  companyId         String
  campaignLeadId    String?
  channel           ContactChannel   @default(WHATSAPP)
  status            MessageStatus    @default(DRAFT)
  direction         MessageDirection @default(OUTBOUND)
  content           String
  contentHash       String
  externalMessageId String?          @unique
  externalStatus    String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  errorCode         String?
  errorDetail       String?
  templateId        String?
  provider          String?
  providerConfig    Json?
  approvedById      String?
  approvedAt        DateTime?
  sentByUserId      String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactAttempts ContactAttempt[]
  activityEvents  ActivityEvent[]

  @@index([companyId])
  @@index([campaignLeadId])
  @@index([organizationId, channel, status])
}

model Conversation {
  id                         String             @id @default(cuid())
  organizationId             String
  companyId                  String
  channel                    ContactChannel     @default(WHATSAPP)
  externalThreadId           String?
  status                     ConversationStatus @default(OPEN)
  lastMessageAt              DateTime?
  assignedToId               String?
  aiSuggestedLabel           String?
  aiSuggestedLabelConfidence Float?
  optOutAt                   DateTime?
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([organizationId, status, assignedToId])
}

model ConsentRecord {
  id             String         @id @default(cuid())
  organizationId String
  companyId      String
  contactId      String?
  channel        ContactChannel
  status         ConsentStatus  @default(NOT_APPLICABLE)
  legalBasis     LegalBasis
  proof          Json?
  sourceKey      String
  grantedAt      DateTime?
  withdrawnAt    DateTime?
  createdAt      DateTime       @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([organizationId, companyId, channel])
  @@index([companyId])
}

model SuppressionList {
  id             String         @id @default(cuid())
  organizationId String
  companyId      String?
  contact        String?
  channel        ContactChannel
  reason         String
  sourceKey      String
  createdAt      DateTime       @default(now())
  expiresAt      DateTime?
  note           String?

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([organizationId, contact])
  @@index([companyId])
}

model Task {
  id             String     @id @default(cuid())
  organizationId String
  companyId      String?
  assigneeId     String?
  type           TaskType
  status         TaskStatus @default(OPEN)
  dueAt          DateTime?
  completedAt    DateTime?
  payload        Json?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, assigneeId])
  @@index([companyId])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorId        String?
  actorType      String
  action         String
  entityType     String
  entityId       String?
  before         Json?
  after          Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  @@index([organizationId, entityType, entityId])
  @@index([organizationId, action, createdAt])
}

model WebhookEvent {
  id             String        @id @default(cuid())
  organizationId String
  provider       String
  eventId        String        @unique
  eventType      String
  payload        Json
  status         WebhookStatus @default(RECEIVED)
  attempts       Int           @default(0)
  lastError      String?
  processedAt    DateTime?
  createdAt      DateTime      @default(now())

  @@index([organizationId, eventType, status])
  @@index([provider, eventId])
}

model ContactStatusHistory {
  id             String          @id @default(cuid())
  organizationId String
  companyId      String
  fromStatus     ContactStatus?
  toStatus       ContactStatus
  transition     String
  actorId        String?
  actorType      String          @default("user")
  messageId      String?
  channel        ContactChannel?
  metadata       Json?
  createdAt      DateTime        @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([organizationId, transition, createdAt])
  @@map("lead_status_history")
}

model ContactAttempt {
  id                String               @id @default(cuid())
  organizationId    String
  leadId            String
  messageId         String?
  channel           ContactChannel
  action            ContactAttemptAction
  confirmedByUserId String?
  confirmedAt       DateTime?
  metadata          Json?
  createdAt         DateTime             @default(now())

  company Company  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  message Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([leadId, action, createdAt])
  @@index([organizationId, channel, action, createdAt])
  @@map("contact_attempts")
}

model ActivityEvent {
  id             String          @id @default(cuid())
  organizationId String
  companyId      String?
  messageId      String?
  actorId        String?
  actorType      String          @default("user")
  eventType      String
  entityType     String?
  entityId       String?
  channel        ContactChannel?
  payload        Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime        @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  message Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([organizationId, eventType, createdAt])
  @@map("activity_events")
}
