# ── Aurora Prospecting API — variáveis de ambiente (todas free) ──

# Banco de dados PostgreSQL (Postgres local ou Neon free tier)
DATABASE_URL="postgresql://usuario:senha@localhost:5432/aurora_prospecting?schema=public"

# Redis para BullMQ — Upstash free tier (rediss:// com TLS) ou Redis local
REDIS_URL="rediss://:TOKEN@HOST:6379"

# Gemini API — chave gratuita do Google AI Studio (https://aistudio.google.com)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash"
# Fallback automático quando a cota da Gemini esgota (free tier Groq: 1.000 req/dia)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# Nome usado na abertura das mensagens ("Olá, tudo bem? Me chamo <SENDER_NAME>.")
SENDER_NAME="Carlos Vinicius"

# PageSpeed Insights API (gratuito, quota diária) — opcional na Fase 1
PAGESPEED_API_KEY=""

# Porta do serviço
PORT=3001

# Ambiente
NODE_ENV="development"

# ── Autenticação ───────────────────────────────────────────────
# Segredo compartilhado com o frontend. Obrigatório (mín. 32 chars).
# Gere com: openssl rand -hex 32
JWT_SECRET=""
# Tempo de vida do access token JWT
JWT_ACCESS_TTL="15m"
# Dias de validade do refresh token (rotacionado a cada uso)
JWT_REFRESH_TTL_DAYS=7
# Organização padrão dos usuários criados pelo script db:create-admin
DEFAULT_ORG_ID="default"
# Bloqueio temporário após tentativas inválidas
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MS=900000
# Rate limiting do login (Redis, por IP)
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_MS=60000
# Token de recuperação de senha (uso único)
RESET_TOKEN_TTL_MINUTES=30
# URL base do frontend usada para montar o link de redefinição (envio futuro por e-mail)
RESET_PASSWORD_BASE_URL="http://localhost:3000"
# Origens permitidas no CORS (separadas por vírgula)
CORS_ORIGIN="http://localhost:3000"

# ── Admin inicial (APENAS para `npm run db:create-admin`; remova depois) ──
# ADMIN_INITIAL_EMAIL="admin@exemplo.com"
# ADMIN_INITIAL_PASSWORD=""
# ADMIN_INITIAL_NAME="Administrador"